# DEPLOYMENT
#
# The simplest option is to run the deployment script from the repository root:
#   yarn deploy [--no-https] [--no-www] [-d ALIAS]... HOST
#
# To deploy manually, follow these steps:
#
# 1) Replace every instance of << HOST >> below with the apex domain name.
#    Uncomment the canonical server and one of its settings sections. For HTTPS,
#    also uncomment the canonical redirect. If aliases are required, uncomment
#    the HTTPS or HTTP-only alias redirect. Add a separate server_name line for
#    every non-canonical domain to each activated alias block, and include every
#    domain in the canonical HTTP-to-HTTPS redirect.
#
# 2) Deploy and enable the nginx configuration.
#    sudo cp nginx.conf.example /etc/nginx/sites-available/<< HOST >>.conf
#    sudo ln -s ../sites-available/<< HOST >>.conf \
#      /etc/nginx/sites-enabled/<< HOST >>.conf
#
#    Do not reload nginx yet; the referenced certificate files do not exist.
#
# 3) Create the site directory.  Site files must be added manually.
#    sudo mkdir -p /var/www/<< HOST >>/site
#    OR
#    sudo git clone https://github.com/qwell/440lab.git /var/www/<< HOST >>/
#
# 4) Run the following command to obtain a new certificate.
#    sudo certbot certonly --standalone --cert-name << HOST >> -d << HOST >> -d www.<< HOST >> \
#      --pre-hook "systemctl stop nginx" --post-hook "systemctl start nginx"
#
#    Add another -d <host> for every additional alias.
#
#    For a staging certificate, add --test-cert.

server {
    #     BEGIN HTTPS settings.
    #     listen      443 ssl;
    #     listen      [::]:443 ssl;
    #
    #     ssl_certificate     /etc/letsencrypt/live/<< HOST >>/fullchain.pem;
    #     ssl_certificate_key /etc/letsencrypt/live/<< HOST >>/privkey.pem;
    #     ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;
    #     include             /etc/letsencrypt/options-ssl-nginx.conf;
    #
    #     add_header  Strict-Transport-Security
    #       "max-age=31536000; includeSubDomains; preload" always;
    #     END HTTPS settings.
    #     BEGIN HTTP settings.
    #     listen      80;
    #     listen      [::]:80;
    #     END HTTP settings.

    root       /var/www/<< HOST >>/site;
    index      index.html;

    access_log /var/log/nginx/<< HOST >>.access.log;
    error_log  /var/log/nginx/<< HOST >>.error.log warn;

    expires    1h;
    add_header Content-Security-Policy
      "default-src 'none'; script-src 'self' 'wasm-unsafe-eval' 'sha256-iIY2TwlaCTpPSFSbruLQ9SL9y7OX1rhF9yW42iQ82U4='; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
      always;

    location / {
        try_files $uri $uri/ =404;
    }
}

