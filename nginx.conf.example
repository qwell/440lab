# DEPLOYMENT
#
# 1) Replace every instance of << DOMAIN >> below with the apex domain name.
#    If www. is not required, all instances (including the entire redirect block) can be safely removed.
#
# 2) Deploy and enable the nginx configuration.
#    sudo cp nginx.conf.example /etc/nginx/sites-available/<< DOMAIN >>.conf
#    sudo ln -s ../sites-available/<< DOMAIN >>.conf \
#      /etc/nginx/sites-enabled/<< DOMAIN >>.conf
#
#    Do not reload nginx yet; the referenced certificate files do not exist.
#
# 3) Create the site directory.  Site files must be added manually.
#    sudo mkdir -p /var/www/<< DOMAIN >>/site
#    OR
#    sudo git clone https://github.com/qwell/440lab.git /var/www/<< DOMAIN >>/
#
# 4) Run the following command to obtain a new certificate.
#    sudo certbot certonly --standalone --cert-name << DOMAIN >> -d << DOMAIN >> -d www.<< DOMAIN >> \
#      --pre-hook "systemctl stop nginx" --post-hook "systemctl start nginx"
#
#    For a staging certificate, add --test-cert.

server {
    listen              443 ssl;
    listen              [::]:443 ssl;
    server_name         << DOMAIN >> www.<< DOMAIN >>;

    ssl_certificate     /etc/letsencrypt/live/<< DOMAIN >>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<< DOMAIN >>/privkey.pem;

    if ($host = www.<< DOMAIN >>) {
        return 301 https://<< DOMAIN >>$request_uri;
    }

    root                /var/www/<< DOMAIN >>/site;

    access_log          /var/log/nginx/<< DOMAIN >>.access.log;
    error_log           /var/log/nginx/<< DOMAIN >>.error.log warn;

    expires             1h;
    add_header          Strict-Transport-Security
      "max-age=31536000; includeSubDomains; preload" always;
    add_header          Content-Security-Policy
      "default-src 'none'; script-src 'self' 'wasm-unsafe-eval' 'sha256-iIY2TwlaCTpPSFSbruLQ9SL9y7OX1rhF9yW42iQ82U4='; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
      always;

    location / {
        try_files $uri $uri/ =404;
    }
}

# HTTP-to-HTTPS redirect.
server {
    listen      80;
    listen      [::]:80;
    server_name << DOMAIN >> www.<< DOMAIN >>;

    return      301 https://<< DOMAIN >>$request_uri;
}
